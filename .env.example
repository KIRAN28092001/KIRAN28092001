# ---------------------------------------------------------------
# Tool Connected App — environment variables
# Copy to .env.local for local development.
# ---------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used by the admin user
# management API, the badge sign-in route and the housekeeping cron route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used for password-reset redirects and e-mail links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/cron/housekeeping (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------
# Edge Function secrets (set with `supabase secrets set ...`, not here):
#   RESEND_API_KEY=re_xxx
#   EMAIL_FROM="Tool Connected <tools@yourdomain.com>"
#   APP_URL=https://your-app.vercel.app
#   WEBHOOK_SECRET=same-value-as-configured-in-the-database-webhook-header
# ---------------------------------------------------------------
